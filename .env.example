GROQ_API_KEY=your_groq_key_here

# LLM slot configuration: provider/model
# GATEKEEPER_LLM=groq/llama-3.1-8b-instant
# PLANNER_LLM=groq/openai/gpt-oss-20b
# AGENT_LLM=groq/openai/gpt-oss-120b
# UTILITY_LLM=groq/llama-3.3-70b-versatile

# Coding adapter (pair-coding mode) planner model: groq model id only, no provider prefix
# CODING_AGENT_MODEL=openai/gpt-oss-120b

# Optional: needed only if using openrouter provider
# OPENROUTER_API_KEY=
# TUSK_SHELLS=voice,tray
# TUSK_ADAPTER_ENV_CACHE_DIR=.tusk_runtime/adapters

# Spoken replies via Groq TTS (set to "off" to disable)
# TUSK_TTS=on

# Playback speed of spoken replies: 1.0 (normal), 1.5, 2.0, ... At 1.0 no speed
# parameter is sent to the TTS API, so the default is unchanged behaviour.
# TUSK_TTS_SPEED=1.0

# Speak a brief refrain of the request before running it (set to "off" to
# disable). Uses the same TTS path, so it is silent when TUSK_TTS is off.
# TUSK_ACK=on

# Agent backend: "tusk" (default, built-in), "codex_exec" (one codex CLI run
# per command), or "codex_mcp" (one persistent `codex mcp-server` process with
# conversation continuity via codex thread ids). Both codex backends need a
# static codex binary baked in via vendor/codex (see vendor/README.md) and the
# ~/.codex auth mount (docker-compose.yml). The entrypoint writes a
# container-local CODEX_HOME with the in-container gnome MCP adapter so codex
# can drive the host desktop. Fallback runs tusk on failure. codex_mcp reuses
# the CODEX_EXEC_MODEL/SANDBOX_MODE/WORKDIR/TIMEOUT_SECONDS values below
# (TIMEOUT_SECONDS acts as an inactivity timeout there); EXTRA_ARGS,
# OUTPUT_SCHEMA_PATH and LOG_RAW_EVENTS apply to codex_exec only.
# AGENT_BACKEND=codex_exec
# AGENT_BACKEND_FALLBACK=tusk
# CODEX_EXEC_MODEL=gpt-5.5
# CODEX_REASONING_EFFORT=low
# CODEX_EXEC_TIMEOUT_SECONDS=420
# --dangerously-bypass-approvals-and-sandbox auto-approves codex's tool calls
# non-interactively (the container is the sandbox); --skip-git-repo-check lets
# codex run outside a git repo.
# CODEX_EXEC_EXTRA_ARGS=--skip-git-repo-check --dangerously-bypass-approvals-and-sandbox

# Tray status indicator (when "tray" is in TUSK_SHELLS)
# TUSK_TRAY_ICON_THEME=light
# TUSK_TRAY_SHOW_LAST_ACTIVITY=false

# Audio settings
# WHISPER_MODEL_SIZE=base
# VAD_AGGRESSIVENESS=2
# AUDIO_SAMPLE_RATE=16000
# AUDIO_FRAME_DURATION_MS=30
