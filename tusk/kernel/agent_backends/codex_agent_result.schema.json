{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tusk.local/schemas/codex-agent-result.schema.json",
  "title": "Codex Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "reply", "final_text"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "failed", "cancelled", "timeout"]
    },
    "reply": {"type": "string"},
    "final_text": {"type": "string"}
  }
}
